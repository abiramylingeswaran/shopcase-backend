DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=900000
UPLOAD_DIR=uploads

# WhatsApp Node — Spring Boot auto-starts whatsapp-service (npm start)
WHATSAPP_PROVIDER=node
WHATSUP_URL=http://127.0.0.1:3001
WHATSAPP_API_KEY=
WHATSAPP_MANAGED_NODE=true
WHATSAPP_SERVICE_DIR=
WHATSAPP_STARTUP_TIMEOUT_SECONDS=90
WHATSAPP_AUTO_NPM_INSTALL=true

# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000

WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=shopease_order_invoice
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_ALLOW_TEST_FALLBACK=false

STORE_WHATSAPP_NUMBER=94702011239
WHATSAPP_DEFAULT_COUNTRY_CODE=94
WHATSAPP_SEND_CUSTOMER_INVOICE=true
WHATSAPP_SEND_STORE_NOTIFICATION=false
